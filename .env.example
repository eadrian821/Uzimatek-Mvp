# =============================================================================
# UZIMATEK MVP — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# Database (Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# JWT
JWT_SECRET="[CHANGE-THIS-IN-PRODUCTION-MINIMUM-32-CHARS]"
JWT_REFRESH_SECRET="[CHANGE-THIS-IN-PRODUCTION-MINIMUM-32-CHARS]"

# Anthropic / Claude AI
ANTHROPIC_API_KEY="sk-ant-[YOUR-KEY]"

# Africa's Talking (SMS/OTP)
AFRICASTALKING_API_KEY="[YOUR-KEY]"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_SENDER_ID="UZIMATEK"

# Daraja API (M-Pesa)
MPESA_CONSUMER_KEY="[YOUR-KEY]"
MPESA_CONSUMER_SECRET="[YOUR-SECRET]"
MPESA_SHORTCODE="[YOUR-SHORTCODE]"
MPESA_PASSKEY="[YOUR-PASSKEY]"
MPESA_CALLBACK_URL="https://api.uzimatek.co.ke/v1/billing/mpesa/callback"
MPESA_ENVIRONMENT="sandbox"

# Email (Resend)
RESEND_API_KEY="re_[YOUR-KEY]"
EMAIL_FROM="noreply@uzimatek.co.ke"

# Redis (for BullMQ)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
API_HOST="0.0.0.0"
API_BASE_URL="http://localhost:3001"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SHA Portal (use sandbox in dev)
SHA_PORTAL_API_URL="https://sandbox.sha.go.ke/api/v1"
SHA_PORTAL_API_KEY="[YOUR-KEY]"
SHA_PORTAL_USERNAME="[YOUR-USERNAME]"
SHA_PORTAL_PASSWORD="[YOUR-PASSWORD]"

# Feature flags
ENABLE_RPA_FALLBACK="true"
ENABLE_MPESA="false"
ENABLE_SMS_OTP="false"

# Node env
NODE_ENV="development"
